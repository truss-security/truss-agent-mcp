# Required for truss-agent-mcp (MCP server) and truss CLI
TRUSS_API_KEY=

# Required for truss search / truss ask only
ANTHROPIC_API_KEY=

# Optional (defaults shown)
TRUSS_API_URL=https://api.truss-security.com
ANTHROPIC_MODEL=claude-sonnet-4-6
TRUSS_ASK_SERVER_PATH=
TRUSS_MCP_MAX_LIMIT=50
TRUSS_MCP_MAX_PAGES=3
TRUSS_MCP_DEBOUNCE_MS=200
