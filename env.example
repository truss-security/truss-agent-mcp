# Preferred: remote OAuth (same hosted MCP as Cursor / Claude Desktop)
# truss-mcp doctor --remote --save-token /tmp/truss-mcp-token
TRUSS_MCP_OAUTH_TOKEN_FILE=
TRUSS_MCP_URL=https://api.truss-security.com/mcp

# LLM for truss-mcp search — set via truss-mcp init (anthropic | openai)
LLM_PROVIDER=
LLM_MODEL=

# Provider API keys — set the one matching LLM_PROVIDER
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Legacy / air-gap only (local stdio MCP + REST)
# TRUSS_MCP_TRANSPORT=stdio
TRUSS_API_KEY=
TRUSS_API_URL=https://api.truss-security.com
TRUSS_MCP_SERVER_PATH=
TRUSS_MCP_MAX_LIMIT=50
TRUSS_MCP_MAX_PAGES=3
TRUSS_MCP_DEBOUNCE_MS=200

# REPL display: auto | always | never (also respects NO_COLOR=1)
TRUSS_MCP_COLOR=auto
