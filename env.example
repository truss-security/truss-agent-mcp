# Required for truss-mcp (all commands)
TRUSS_API_KEY=

# LLM for truss-mcp search / ask (anthropic | openai)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Provider API keys — set the one matching LLM_PROVIDER
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional (defaults shown)
TRUSS_API_URL=https://api.truss-security.com
TRUSS_MCP_SERVER_PATH=
TRUSS_MCP_MAX_LIMIT=50
TRUSS_MCP_MAX_PAGES=3
TRUSS_MCP_DEBOUNCE_MS=200

# Deprecated — use LLM_MODEL instead
# ANTHROPIC_MODEL=claude-sonnet-4-6
