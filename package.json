{
  "name": "@truss-security/truss-agent-mcp",
  "version": "1.1.0",
  "description": "Official Truss MCP server and CLI — query threat intelligence via FilterQL (stdio + truss-mcp)",
  "type": "module",
  "main": "dist/truss-cli.js",
  "bin": {
    "truss-mcp": "./dist/truss-cli.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "env.example",
    "CHANGELOG.md",
    "guides/truss-cli.md",
    "guides/getting-started.md",
    "config/cursor.mcp.json",
    "config/cursor.mcp.stdio.json",
    "config/claude_desktop_config.json",
    "config/claude_desktop_config.stdio.json",
    "config/mcp-registry.json"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/truss-cli.js",
    "clean": "rm -rf dist",
    "start": "node dist/truss-cli.js mcp",
    "dev": "tsx src/truss-cli.ts mcp",
    "truss-mcp": "node dist/truss-cli.js",
    "truss:init": "node dist/truss-cli.js init",
    "truss:doctor": "node dist/truss-cli.js doctor",
    "truss:search": "node dist/truss-cli.js search",
    "truss:mcp": "node dist/truss-cli.js mcp",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "smoke": "npm run build && node --import tsx --test tests/smoke.test.ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "truss",
    "mcp",
    "model-context-protocol",
    "threat-intelligence",
    "filterql",
    "stix",
    "cli"
  ],
  "author": "Truss Security",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@truss-security/truss-sdk": "^0.5.3",
    "openai": "^4.104.0",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/truss-security/truss-agent-mcp.git"
  }
}
